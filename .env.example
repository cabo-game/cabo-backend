# Cabo backend — environment variables
#
# Copy this file to .env and fill in real values for local development.
# The app does NOT load .env automatically — there is no dotenv-style
# library wired in (see go.mod). Export these into your shell before
# running a binary, e.g.:
#
#   export $(grep -v '^#' .env | xargs)
#   go run ./cmd/roomsvc
#
# or use a tool like direnv. Each binary only reads the variables listed
# under its own section below — roomsvc and authsvc are independent
# processes (spine AD-6, AD-8).

# ---------------------------------------------------------------------------
# cmd/roomsvc
# ---------------------------------------------------------------------------

# Comma-separated etcd endpoints. Required.
ETCD_ENDPOINTS=localhost:2379

# Address other services (authsvc, and eventually clients) should use to
# reach this roomsvc instance — never the bare bind address (":8081"), and
# not always the same as where it's listening from behind a LB/NAT/container.
# Required.
ROOMSVC_ADVERTISE_ADDR=localhost:8081

# How long this instance's etcd liveness lease lasts before it must be
# renewed (AD-7) — see the "roomsvc Registration & Heartbeat LLD" for why
# 10s. Optional, default: 10s.
ROOMSVC_LEASE_TTL=10s

# Opaque capacity value written into this instance's etcd registration,
# for a future server-placement policy to consume — nothing reads it yet.
# Optional, default: 0.
ROOMSVC_CAPACITY=0

# Base URL of authsvc's internal API — roomsvc calls POST /rooms/register
# on it whenever a new room is created (AD-9, AD-3). Required.
AUTHSVC_INTERNAL_ADDR=http://localhost:8080

# ---------------------------------------------------------------------------
# cmd/authsvc
# ---------------------------------------------------------------------------

# Redis address backing the room-id -> server-address directory (AD-3).
# Required.
REDIS_ADDR=localhost:6379

# Comma-separated etcd endpoints — the same etcd cluster roomsvc instances
# register into (AD-7); authsvc reads that roster to pick a server for a
# new room. Required.
ETCD_ENDPOINTS=localhost:2379
